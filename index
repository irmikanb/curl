function pdf(u,k){const en=new TextEncoder(),P=[],O=[],N=u.length;let n=0;
 const put=d=>{const b=typeof d=='string'?en.encode(d):d;P.push(b);n+=b.length},
 ob=(i,...b)=>{O[i]=n;put(i+' 0 obj\n');b.forEach(put);put('\nendobj\n')};
 put('%PDF-1.4\n');
 ob(1,'<</Type/Catalog/Pages 2 0 R>>');
 ob(2,'<</Type/Pages/Count '+N+'/Kids['+u.map((_,i)=>(3+3*i)+' 0 R').join(' ')+']>>');
 u.forEach((s,i)=>{const b=Uint8Array.from(atob(s.split(',')[1]),ch=>ch.charCodeAt(0)),p=3+3*i,ct='q 595.28 0 0 841.89 0 0 cm /I Do Q';
  ob(p,'<</Type/Page/Parent 2 0 R/MediaBox[0 0 595.28 841.89]/Resources<</XObject<</I '+(p+2)+' 0 R>>>>/Contents '+(p+1)+' 0 R/Annots['+(k[i]||[]).map(a=>{const f=595.28/PW,e=encodeURI(a.u).replace(/[()\\]/g,'\\$&');return '<</Type/Annot/Subtype/Link/Border[0 0 0]/Rect['+[a.x*f,841.89-(a.y+a.h)*f,(a.x+a.w)*f,841.89-a.y*f].map(v=>v.toFixed(2)).join(' ')+']/A<</S/URI/URI('+e+')>>>>'}).join('')+']>>');
  ob(p+1,'<</Length '+ct.length+'>>\nstream\n'+ct+'\nendstream');
  ob(p+2,'<</Type/XObject/Subtype/Image/Width '+PW+'/Height '+PH+'/ColorSpace/DeviceRGB/BitsPerComponent 8/Filter/DCTDecode/Length '+b.length+'>>\nstream\n',b,'\nendstream')});
 const x0=n,T=3*N+3;
