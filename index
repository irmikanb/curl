 for(let i=1;i<T;i++)put(String(O[i]).padStart(10,'0')+' 00000 n \n');
 put('trailer\n<</Size '+T+'/Root 1 0 R>>\nstartxref\n'+x0+'\n%%EOF');
 return new Blob(P,{type:'application/pdf'})}
async function mk(){let u,k;
 try{({u,k}=await build())}catch(e){console.error(e);return toast('Не удалось собрать PDF')}
 if(!$('#pp'))return;
 PB=pdf(u,k);
 $('#pp').innerHTML=u.map(s=>`<img src="${s}" alt="Страница памятки">`).join('');
 $('#pm').textContent='Готово. Проверьте памятку и сохраните PDF.';
 let can=false;try{can=navigator.canShare&&navigator.canShare({files:[new File([PB],fn(),{type:'application/pdf'})]})}catch(e){}
 $('#pa').insertAdjacentHTML('beforeend',`<button class="btn" onclick="dl()">Скачать PDF</button>${can?'<button class="btn" onclick="sh()">Поделиться</button>':''}`)}
function fdl(b,n){const a=document.createElement('a');a.href=URL.createObjectURL(b);a.download=n;a.style.display='none';document.body.appendChild(a);a.click();setTimeout(()=>{a.remove();URL.revokeObjectURL(a.href)},5000)}
function dl(){fdl(PB,fn())}
function sh(){navigator.share({files:[new File([PB],fn(),{type:'application/pdf'})]}).catch(()=>{})}
go('home');
