<!DOCTYPE html>
<html lang="ru"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1">
<title>Hair Care Studio</title>
<link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:wght@500;600&family=Manrope:wght@400;500;700&display=swap">
<style>
:root{--bg:#f6f4ef;--ink:#24201d;--mut:#7a716a;--acc:#a67c62;--line:#e4ded6;--soft:#efeae3}
*{box-sizing:border-box}
body{margin:0;background:var(--bg);color:var(--ink);font:15px/1.5 Manrope,system-ui,-apple-system,"Segoe UI",Roboto,sans-serif}
h1,h2,h3,.serif,nav b{font-family:"Cormorant Garamond",Georgia,"Times New Roman",serif;font-weight:500;margin:0}
h1{font-size:38px;line-height:1.15}h2{font-size:26px}
nav{display:flex;flex-wrap:wrap;gap:6px 22px;align-items:center;padding:16px 28px;border-bottom:1px solid var(--line);position:sticky;top:0;background:var(--bg);z-index:5}
nav b{font-size:24px;margin-right:8px}
nav a{cursor:pointer;color:var(--mut)}nav a.on{color:var(--ink);font-weight:700}
main{max-width:1080px;margin:0 auto;padding:28px 20px 80px}
.card{background:#fff;border-radius:12px;box-shadow:0 2px 12px #0000000d;padding:24px;margin-bottom:22px}
.eyebrow{font-size:12px;letter-spacing:.16em;text-transform:uppercase;color:var(--mut)}
.mut{color:var(--mut)}.acc{color:var(--acc)}
label{display:block;font-size:14px;margin:14px 0 5px}
input,textarea,select{width:100%;padding:11px 14px;border:1px solid var(--line);border-radius:8px;font:inherit;background:#fff;color:inherit}
input:focus-visible,textarea:focus-visible,select:focus-visible,button:focus-visible,a:focus-visible{outline:2px solid var(--acc);outline-offset:1px}
textarea{min-height:84px;resize:vertical}
.btn{background:var(--ink);color:#fff;border:0;border-radius:8px;padding:11px 18px;font:inherit;font-weight:500;cursor:pointer;width:auto}
.btn.l{background:#fff;color:var(--ink);border:1px solid var(--line)}
.row{display:flex;gap:16px;flex-wrap:wrap}.row>*{flex:1;min-width:200px}
.top{display:flex;justify-content:space-between;align-items:flex-end;gap:14px;flex-wrap:wrap}
.bar{display:flex;justify-content:space-between;gap:10px;margin-top:16px}
.grid{display:grid;grid-template-columns:repeat(auto-fill,minmax(250px,1fr));gap:20px}
.g2{display:grid;grid-template-columns:repeat(auto-fill,minmax(280px,1fr));gap:12px;margin-bottom:6px}
.pi{display:flex;gap:12px;align-items:center;border:1px solid var(--line);border-radius:8px;padding:12px;margin:0;cursor:pointer}
.pi input{width:auto}
.pi img,.ph{width:60px;height:60px;object-fit:contain;background:var(--soft);border-radius:4px;flex:none}
.big{width:100%;height:auto;aspect-ratio:1;object-fit:contain;background:var(--soft);border-radius:8px;margin-bottom:10px;display:block}
.ct{font:700 18px Manrope,system-ui,sans-serif;letter-spacing:.12em;text-transform:uppercase;padding-bottom:12px;border-bottom:1px solid var(--line);margin-bottom:16px}
.ct i{font-style:normal;color:var(--acc);font-weight:500;margin-right:8px}
dialog{border:0;border-radius:12px;padding:24px;width:min(480px,94vw);background:var(--bg)}
dialog::backdrop{background:#24201d80}
#ts{position:fixed;left:50%;bottom:24px;transform:translateX(-50%);background:var(--ink);color:#fff;padding:10px 18px;border-radius:8px;display:none;z-index:9}
input,textarea,select{font-size:16px}
.pi input{width:22px;height:22px;flex:none}
.btn{min-height:44px}
dialog{max-height:92vh;overflow:auto}
#pp img{display:block;width:100%;max-width:794px;height:auto;margin:0 auto 16px;background:#fff;box-shadow:0 2px 12px #0000001a}
@media(max-width:600px){
 nav{flex-wrap:nowrap;overflow-x:auto;white-space:nowrap;gap:18px;padding:12px 16px}
 nav b{font-size:20px;margin-right:0}
 main{padding:18px 12px 60px}.card{padding:16px}h1{font-size:30px}
 .row>*{min-width:100%}.top .btn{width:100%}#pa{width:100%}
}
.lg{cursor:pointer}
.hm{display:grid;grid-template-columns:1fr 1fr;gap:20px;margin-top:28px}
.hc{display:flex;flex-direction:column;gap:8px;justify-content:flex-end;min-height:170px;padding:26px 30px;border:0;border-radius:12px;background:#fff;box-shadow:0 2px 12px #0000000d;cursor:pointer;color:var(--ink);font:inherit;text-align:left;width:100%}
.hc b{letter-spacing:.12em;font-size:20px}.hc span{color:var(--mut)}
.hc.dk{background:var(--ink);color:#fff}.hc.dk span{color:#ffffffb3}
.mr{display:flex;justify-content:space-between;align-items:center;gap:12px;flex-wrap:wrap;padding:14px 20px;border-top:1px solid var(--line)}.mr:first-child{border:0}
.mb{display:flex;gap:8px;flex-wrap:wrap}.mb .btn{padding:8px 14px;min-height:40px}
@media(max-width:600px){.hm{grid-template-columns:1fr}.hc{min-height:130px}}
</style></head><body>
<nav><b class="lg" tabindex="0" role="link" onclick="go('home')" onkeydown="if(event.key=='Enter')go('home')">Hair Care Studio</b>
<a data-v="memo" onclick="go('memo')">Новая памятка</a><a data-v="prods" onclick="go('prods')">База средств</a><a data-v="cats" onclick="go('cats')">Категории</a><a data-v="set" onclick="go('set')">Настройки</a></nav>
<main></main><dialog id="dg"></dialog><div id="ts"></div>
<script>
const $=s=>document.querySelector(s),
E=s=>String(s??'').replace(/[&<>"]/g,c=>({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;'}[c])),
uid=()=>Math.random().toString(36).slice(2,9),K='hcs_v1',
nm=()=>({name:'',date:new Date().toLocaleDateString('en-CA'),note:'',sel:{},cc:{},rec:''});
const seed=()=>({prods:[],set:{},cats:[
 ['ШАМПУНЬ','Очищение кожи головы и волос.','Нанести на влажную кожу головы, вспенить и смыть.','При каждом мытье.'],
 ['КОНДИЦИОНЕР','Смягчение, разглаживание и лёгкое расчёсывание волос.','Нанести на влажные волосы от середины до кончиков, оставить 1–2 минуты, смыть.','После каждого мытья.'],
 ['МАСКА','Глубокое питание и восстановление волос.','Нанести на влажные волосы, оставить 5–10 минут, тщательно смыть.','1–2 раза в неделю вместо кондиционера.'],
 ['НЕСМЫВАЕМЫЙ УХОД','Дополнительное увлажнение, защита и облегчение расчёсывания.','Нанести небольшое количество на влажные или сухие волосы по длине.','После мытья или в течение дня.'],
 ['ТЕРМОЗАЩИТА','Защита волос от высоких температур при укладке.','Нанести на сухие или слегка влажные волосы перед горячей укладкой.','Перед каждой горячей укладкой.']
 ].map((c,i)=>({id:'c'+i,name:c[0],o:i+1,why:c[1],how:c[2],when:c[3]}))});
let D;try{D=JSON.parse(localStorage.getItem(K))}catch(e){}D=D||seed();D.memos=D.memos||[];
let M=nm(),qr='',cur=null,curImg='';
const save=()=>{try{localStorage.setItem(K,JSON.stringify(D))}catch(e){toast('Не хватает места в браузере. Скачайте копию в «Настройках» и удалите лишние фото.')}};
function toast(t){const e=$('#ts');e.textContent=t;e.style.display='block';clearTimeout(e.t);e.t=setTimeout(()=>e.style.display='none',3200)}
const sorted=()=>[...D.cats].sort((a,b)=>a.o-b.o),
cn=id=>(D.cats.find(c=>c.id==id)||{}).name||'',
img=p=>p.img?`<img src="${p.img}" alt="">`:'<span class="ph"></span>';
function rz(f,max,cb){if(!f)return;const r=new FileReader();r.onload=()=>{const im=new Image();im.onload=()=>{const s=Math.min(1,max/Math.max(im.width,im.height)),c=document.createElement('canvas');c.width=im.width*s;c.height=im.height*s;const x=c.getContext('2d');x.fillStyle='#fff';x.fillRect(0,0,c.width,c.height);x.drawImage(im,0,0,c.width,c.height);cb(c.toDataURL('image/jpeg',.78))};im.src=r.result};r.readAsDataURL(f)}

function go(v){
 if(v=='set')qr=D.set.qr||'';
 $('main').innerHTML={home:vHome,memo:vMemo,prods:vProds,cats:vCats,set:vSet,pdf:vPdf}[v]();
 if(v=='prods')lp();if(v=='home')lm();
 document.querySelectorAll('nav a').forEach(a=>a.classList.toggle('on',a.dataset.v==(v=='pdf'?'memo':v)));
 scrollTo(0,0)}

/* Главная и база памяток */
function vHome(){return `<div class="eyebrow">Кабинет мастера</div><h1 style="max-width:640px;margin:6px 0 12px">Персональные памятки по уходу за волосами</h1><p class="mut" style="max-width:520px">Отметьте средства из своей базы, добавьте рекомендации и отправьте клиенту готовый PDF.</p>
<div class="hm"><button class="hc dk" onclick="M=nm();go('memo')"><span style="font-size:28px;line-height:1">+</span><b>НОВАЯ ПАМЯТКА</b><span>Собрать памятку для клиента</span></button><button class="hc" onclick="go('prods')"><b>БАЗА СРЕДСТВ</b><span>Добавить и отредактировать продукты</span></button></div>
<div class="top" style="margin-top:40px"><h2>Последние памятки</h2><span class="mut">${D.memos.length}</span></div>
<input id="mq" placeholder="Поиск по имени клиента" oninput="lm()" style="margin:14px 0"><div class="card" style="padding:0" id="ml"></div>`}
function lm(){const q=$('#mq').value.toLowerCase(),r=[...D.memos].sort((a,b)=>b.upd-a.upd).filter(m=>(m.name||'').toLowerCase().includes(q));
$('#ml').innerHTML=r.map(m=>`<div class="mr"><div><b>${E(m.name)||'Без имени'}</b> <span class="mut">${m.date.split('-').reverse().join('.')}</span></div><div class="mb"><button class="btn l" onclick="om('${m.id}','pdf')">Открыть</button><button class="btn l" onclick="om('${m.id}','memo')">Изменить</button><button class="btn l" onclick="xm('${m.id}')">Удалить</button></div></div>`).join('')||`<p class="mut" style="padding:20px;margin:0">${D.memos.length?'Ничего не найдено.':'Пока нет памяток. Нажмите «Новая памятка» и сформируйте первую.'}</p>`}
function sv(){if(!M.id)M.id=uid();M.upd=Date.now();const i=D.memos.findIndex(m=>m.id==M.id),o=JSON.parse(JSON.stringify(M));i<0?D.memos.unshift(o):D.memos[i]=o;save()}
function om(id,v){M=JSON.parse(JSON.stringify(D.memos.find(m=>m.id==id)));go(v)}
function xm(id){if(!confirm('Удалить памятку?'))return;D.memos=D.memos.filter(m=>m.id!=id);save();go('home')}

/* Новая памятка */
function vMemo(){return `<div class="card"><div class="eyebrow">Персональный уход за волосами</div><h1>${M.id?'Редактирование памятки':'Новая памятка'}</h1>
<div class="row"><div><label>Имя клиента</label><input value="${E(M.name)}" oninput="M.name=this.value" placeholder="Анна Иванова"></div>
<div><label>Дата</label><input type="date" value="${M.date}" oninput="M.date=this.value"></div></div>
<label>Примечание мастера</label><textarea oninput="M.note=this.value" placeholder="Короткое вступление для клиента">${E(M.note)}</textarea></div>
<div class="eyebrow" style="margin:0 0 12px">Категории ухода</div>`+
sorted().map((c,i)=>{const ps=D.prods.filter(p=>p.cat==c.id);
return `<div class="card"><h2 class="ct"><i>0${i+1}</i>${E(c.name)}</h2>`+
(ps.length?`<div class="g2">${ps.map(p=>`<label class="pi"><input type="checkbox" ${M.sel[p.id]?'checked':''} onchange="M.sel['${p.id}']=this.checked">${img(p)}<span><b>${E(p.name)}</b>${p.where?`<br><span class="mut">Где купить: ${E(p.where)}</span>`:''}${p.art?`<br><span class="mut">Артикул: ${E(p.art)}</span>`:''}</span></label>`).join('')}</div>`:'<p class="mut">В этой категории пока нет средств. Добавьте их в «Базе средств».</p>')+
`<label>Комментарий мастера к разделу</label><textarea placeholder="Например: чередовать с маской" oninput="M.cc['${c.id}']=this.value">${E(M.cc[c.id])}</textarea></div>`}).join('')+
`<div class="card"><h2>Рекомендации мастера</h2><textarea style="min-height:140px;margin-top:12px" oninput="M.rec=this.value" placeholder="• Использовать термозащиту перед каждой горячей укладкой.">${E(M.rec)}</textarea></div>
<button class="btn" style="width:100%" onclick="sv();go('pdf')">Сформировать памятку</button>
<p style="text-align:center"><button class="btn l" onclick="if(confirm('Очистить форму?')){M=nm();go('memo')}">Начать заново</button></p>`}

/* База средств */
function vProds(){return `<div class="top"><div><div class="eyebrow">Ваши продукты</div><h1>База средств</h1></div><button class="btn" onclick="edP()">+ Добавить средство</button></div>
<div class="row" style="margin:18px 0 22px"><input id="q" placeholder="Поиск по названию или артикулу" oninput="lp()" style="flex:3"><select id="fc" onchange="lp()"><option value="">Все категории</option>${sorted().map(c=>`<option value="${c.id}">${E(c.name)}</option>`).join('')}</select></div><div class="grid" id="pl"></div>`}
function lp(){const q=$('#q').value.toLowerCase(),f=$('#fc').value,
r=D.prods.filter(p=>(!f||p.cat==f)&&(p.name+' '+(p.art||'')).toLowerCase().includes(q));
$('#pl').innerHTML=r.map(p=>`<div class="card" style="padding:14px;margin:0">${p.img?`<img class="big" src="${p.img}" alt="">`:'<div class="big"></div>'}<div class="eyebrow">${E(cn(p.cat))}</div><h3 style="font-size:22px">${E(p.name)}</h3><div class="mut">${p.where?'Где купить: '+E(p.where):''}${p.art?'<br>Артикул: '+E(p.art):''}</div><div style="margin-top:12px;display:flex;gap:8px"><button class="btn l" onclick="edP('${p.id}')">Изменить</button><button class="btn l" aria-label="Удалить" onclick="dP('${p.id}')">Удалить</button></div></div>`).join('')||`<p class="mut">${D.prods.length?'Ничего не найдено.':'База пуста. Нажмите «Добавить средство» и загрузите первое фото.'}</p>`}
function edP(id){const p=D.prods.find(x=>x.id==id)||{};cur=p.id||null;curImg=p.img||'';
$('#dg').innerHTML=`<h2>${id?'Изменить':'Добавить'} средство</h2><label>Фото</label><input type="file" accept="image/*" onchange="rz(this.files[0],500,d=>{curImg=d;$('#pv').innerHTML='<img src=&quot;'+d+'&quot; style=&quot;height:90px;margin-top:8px&quot;>'})"><div id="pv">${curImg?`<img src="${curImg}" style="height:90px;margin-top:8px" alt="">`:''}</div>
<label>Название</label><input id="pn" value="${E(p.name)}"><label>Категория</label><select id="pc">${sorted().map(c=>`<option value="${c.id}" ${c.id==p.cat?'selected':''}>${E(c.name)}</option>`).join('')}</select>
<label>Где купить</label><input id="pw" value="${E(p.where)}"><label>Артикул</label><input id="pa" value="${E(p.art)}">
<label>Комментарий мастера (попадёт в памятку)</label><textarea id="pk">${E(p.com)}</textarea>
<div class="bar"><button class="btn l" onclick="$('#dg').close()">Отмена</button><button class="btn" onclick="sP()">Сохранить</button></div>`;$('#dg').showModal()}
function sP(){const n=$('#pn').value.trim();if(!n)return toast('Введите название средства');
const o={id:cur||uid(),name:n,cat:$('#pc').value,where:$('#pw').value,art:$('#pa').value,com:$('#pk').value,img:curImg},i=D.prods.findIndex(p=>p.id==cur);
i<0?D.prods.push(o):D.prods[i]=o;save();$('#dg').close();go('prods')}
function dP(id){const u=D.memos.filter(m=>m.sel[id]).length;if(!confirm(u?'Средство есть в памятках ('+u+'), из них оно пропадёт. Удалить?':'Удалить средство из базы?'))return;D.prods=D.prods.filter(p=>p.id!=id);delete M.sel[id];save();lp()}

/* Категории */
function vCats(){return `<div class="top"><h1>Категории</h1><button class="btn" onclick="aC()">+ Добавить категорию</button></div><div style="margin-top:22px">`+
sorted().map(c=>`<div class="card" id="c${c.id}"><div class="row"><div style="flex:5"><label>Название</label><input data-k="name" value="${E(c.name)}"></div><div style="flex:1;min-width:90px"><label>Порядок</label><input data-k="o" type="number" value="${c.o}"></div></div>
<div class="row"><div><label>Назначение</label><textarea data-k="why">${E(c.why)}</textarea></div><div><label>Как применять</label><textarea data-k="how">${E(c.how)}</textarea></div><div><label>Когда / как часто</label><textarea data-k="when">${E(c.when)}</textarea></div></div>
<div class="bar"><button class="btn l" onclick="xC('${c.id}')">Удалить</button><button class="btn" onclick="sC('${c.id}')">Сохранить</button></div></div>`).join('')+'</div>'}
function sC(id){const c=D.cats.find(x=>x.id==id);document.querySelectorAll('#c'+id+' [data-k]').forEach(e=>c[e.dataset.k]=e.dataset.k=='o'?+e.value||0:e.value);save();toast('Категория сохранена')}
function aC(){D.cats.push({id:uid(),name:'НОВАЯ КАТЕГОРИЯ',o:Math.max(0,...D.cats.map(c=>c.o))+1,why:'',how:'',when:''});save();go('cats')}
function xC(id){if(!confirm('Удалить категорию вместе со средствами из неё?'))return;D.prods=D.prods.filter(p=>p.cat!=id);D.cats=D.cats.filter(c=>c.id!=id);save();go('cats')}

/* Настройки */
function vSet(){const s=D.set;return `<div class="eyebrow">Контакты в памятке</div><h1>Настройки</h1><div class="card" style="max-width:560px;margin-top:18px">`+
[['n','Имя мастера'],['p','Телефон'],['i','Instagram'],['w','Сайт']].map(([k,l])=>`<label>${l}</label><input id="s${k}" value="${E(s[k])}">`).join('')+
`<label>QR-код (картинка)</label><input type="file" accept="image/*" onchange="rz(this.files[0],400,d=>{qr=d;toast('QR загружен. Нажмите «Сохранить»')})">${s.qr?`<img src="${s.qr}" style="height:80px;margin-top:8px" alt="">`:''}
<div style="margin-top:18px"><button class="btn" onclick="sS()">Сохранить</button></div></div>
<div class="card" style="max-width:560px"><h2>Резервная копия</h2><p class="mut">Данные хранятся в этом браузере на этом компьютере. Скачивайте копию после крупных изменений: по ней можно восстановить базу, если очистится браузер или вы перейдёте на другой компьютер.</p>
<button class="btn l" onclick="ex()">Скачать копию</button> <label class="btn l" style="display:inline-block;margin:0">Загрузить копию<input type="file" accept=".json" hidden onchange="im(this.files[0])"></label></div>`}
function sS(){D.set={n:$('#sn').value,p:$('#sp').value,i:$('#si').value,w:$('#sw').value,qr};save();toast('Настройки сохранены')}
function ex(){fdl(new Blob([JSON.stringify(D)],{type:'application/octet-stream'}),'hair-care-backup-'+new Date().toLocaleDateString('en-CA')+'.json');toast('Копия скачивается. Если ничего не произошло, откройте приложение в обычном браузере (Chrome, Safari), а не внутри мессенджера.')}
function im(f){if(!f)return;const r=new FileReader();r.onload=()=>{try{const d=JSON.parse(r.result);if(!d.cats||!d.prods)throw 0;D=d;D.memos=D.memos||[];save();toast('Копия загружена');go('memo')}catch(e){toast('Этот файл не подходит')}};r.readAsText(f)}

/* Предпросмотр и PDF (страницы рисуются на canvas, PDF собирается без библиотек) */
const PW=1240,PH=1754,MX=110,MT=90,MB=150,CW=PW-2*MX,SE='"Cormorant Garamond",Georgia,serif',SA='Manrope,system-ui,sans-serif',
K1='#24201d',AC='#a67c62',MU='#7a716a',BG='#f6f4ef',LN='#e4ded6';
let PB=null;
const fn=()=>('Памятка по уходу за волосами '+M.name).trim().replace(/[\\/:*?"<>|]/g,'')+'.pdf',
loadImg=s=>new Promise(r=>{if(!s)return r(null);const i=new Image();i.onload=()=>r(i);i.onerror=()=>r(null);i.src=s});
function vPdf(){setTimeout(mk,30);return `<div class="top"><div><div class="eyebrow">Предпросмотр PDF</div><h1>${E(M.name)||'Памятка'}</h1></div><div id="pa" style="display:flex;gap:10px;flex-wrap:wrap"><button class="btn l" onclick="go('memo')">Назад к редактированию</button></div></div><p class="mut" id="pm">Собираю PDF…</p><div id="pp"></div>`}
async function build(){
